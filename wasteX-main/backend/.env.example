# WasteX Backend Environment Variables
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration (Defaults to localhost:27017 or in-memory fallback)
MONGO_URL=mongodb://localhost:27017

# SerpApi Key for External Recycling Web Leads Discovery (Optional)
SERPAPI_KEY=YOUR_SERPAPI_KEY_HERE

# AI Layer Provider Configuration
# Options: "huggingface" | "openai" | "local_kg"
LLM_PROVIDER=huggingface

# Hugging Face Configuration (Optional - for Llama-3.2-1B / Inference API)
HF_TOKEN=YOUR_HF_TOKEN_HERE
HF_MODEL=meta-llama/Llama-3.2-1B-Instruct

# OpenAI / OpenAI-Compatible Configuration (Optional)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Twilio Multi-Channel Communication Configuration (SMS, WhatsApp, Voice)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=YOUR_TWILIO_PHONE_NUMBER
TWILIO_WHATSAPP_NUMBER=YOUR_TWILIO_WHATSAPP_NUMBER
